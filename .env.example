# =============================================================================
# EduDigi — environment variables. Copy to .env.local (never commit real values).
# Variables prefixed NEXT_PUBLIC_ are sent to the browser: NEVER put a secret there.
# =============================================================================

# --- Public (browser) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Product name shown before the platform settings are loaded (configurable later in /platform).
NEXT_PUBLIC_APP_NAME=EduDigi

# --- Server only ---------------------------------------------------------------
# development | preview | staging | production | test
APP_ENV=development
# Service role key: server-side only, limited documented uses (see documentation/securite.md).
SUPABASE_SERVICE_ROLE_KEY=
# >= 16 random chars, used to hash e-mails/IPs in security logs and rate-limit keys.
# Generate: openssl rand -base64 32
SECURITY_HASH_SALT=
# One-time token to create the first platform administrator at /setup (>= 24 chars).
# Remove it from the environment once the administrator exists.
SETUP_TOKEN=
# Shared secret for the scheduled outbound e-mail/SMS worker (>= 24 chars).
CRON_SECRET=

# --- AI assistant (disabled by default) ----------------------------------------
# anthropic | disabled
AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Send student names to the AI provider only once a data processing agreement is in place.
AI_ALLOW_PERSONAL_DATA=false
AI_MAX_TOOL_ROUNDS=5

# --- Notifications ---------------------------------------------------------------
# resend | log | disabled   (log = write a redacted line to the server log, for development)
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="EduDigi <no-reply@example.com>"
# twilio | log | disabled
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
